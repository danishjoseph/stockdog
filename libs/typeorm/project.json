{
  "name": "typeorm",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/typeorm/src",
  "projectType": "library",
  "tags": [],
  "// targets": "to see all targets run: nx show project typeorm --web",
  "targets": {
    "migration-generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register --project {projectRoot}/tsconfig.json ./node_modules/typeorm/cli.js migration:generate -d {projectRoot}/src/lib/data-source.ts -p {projectRoot}/src/lib/migrations/{args.name}",
        "envFile": ".env"
      }
    },
    "migration-run": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register --project {projectRoot}/tsconfig.json ./node_modules/typeorm/cli.js migration:run -d {projectRoot}/src/lib/data-source.ts",
      }
    },
    "migration-revert": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register --project {projectRoot}/tsconfig.json ./node_modules/typeorm/cli.js migration:revert -d {projectRoot}/src/lib/data-source.ts",
      }
    },
    "migration-show": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register --project {projectRoot}/tsconfig.json ./node_modules/typeorm/cli.js migration:show -d {projectRoot}/src/lib/data-source.ts",
      }
    }
  }
}
